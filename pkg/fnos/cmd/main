#!/bin/bash
# ============================================================
# fn-docker-desk - 应用生命周期管理（start/stop/status）
# ------------------------------------------------------------
# install_type=root：生命周期脚本以 root 运行（需修改系统 Web 文件
# /usr/trim/www、安装 systemd 服务）。Web 管理服务（web.py）也以
# root 运行（需调用主脚本修改系统文件 + 直接访问 docker 命令）。
# ============================================================
set -euo pipefail

DEST_DIR="/usr/fn-docker-desk"
SVC_PORT="${TRIM_SERVICE_PORT:-5558}"
WEB_LOG="/var/log/fn-docker-desk-web.log"

# ---------------- 公共函数 ----------------

# 从 TRIM_APPDEST 复制工具文件到稳定目录（幂等）
sync_app_files() {
    mkdir -p "$DEST_DIR"
    if [ -d "${TRIM_APPDEST:-}" ]; then
        cp -f "$TRIM_APPDEST"/fn-docker-desk.sh "$DEST_DIR/" 2>/dev/null || true
        cp -f "$TRIM_APPDEST"/web.py "$DEST_DIR/" 2>/dev/null || true
        cp -f "$TRIM_APPDEST"/desktop-inject.js "$DEST_DIR/" 2>/dev/null || true
        chmod +x "$DEST_DIR/fn-docker-desk.sh" 2>/dev/null || true
    fi
}

# 启动 Web 管理服务（以 root 运行）
start_web_service() {
    # 已运行则跳过
    if pgrep -f "web.py --port ${SVC_PORT}" >/dev/null 2>&1; then
        return 0
    fi
    [ -f "$DEST_DIR/web.py" ] || return 0

    # 确保 web 日志可写
    touch "$WEB_LOG" 2>/dev/null || true
    chmod 644 "$WEB_LOG" 2>/dev/null || true

    # 以 root 运行（web.py 需调用主脚本 require_root + 直接访问 docker）
    nohup python3 -u "$DEST_DIR/web.py" --port "$SVC_PORT" \
        >>"$WEB_LOG" 2>&1 &
    sleep 1
}

# ---------------- 生命周期入口 ----------------

case $1 in
start)
    # 1. 同步工具文件到稳定目录
    sync_app_files
    # 2. 应用桌面注入（幂等；升级后自动从持久卷恢复配置）
    if [ -f "$DEST_DIR/fn-docker-desk.sh" ]; then
        bash "$DEST_DIR/fn-docker-desk.sh" apply --quiet || true
    fi
    # 3. 启动 Web 管理服务
    start_web_service
    exit 0
    ;;
stop)
    pkill -f "web.py --port ${SVC_PORT}" 2>/dev/null || true
    exit 0
    ;;
status)
    if pgrep -f "web.py --port ${SVC_PORT}" >/dev/null 2>&1; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
