#!/bin/bash
# ============================================================
# fn-docker-desk - 应用生命周期管理（start/stop/status）
# ------------------------------------------------------------
# 按飞牛 fnOS 官方规范：
# - TRIM_APPDEST = /var/apps/fn-docker-desk/target  : 运行文件
# - TRIM_PKGVAR  = /var/apps/fn-docker-desk/var     : 持久数据
# - TRIM_SERVICE_PORT : manifest.service_port 分配的端口
# install_type=root：生命周期脚本以 root 运行（需修改系统 Web 文件
# /usr/trim/www、安装 systemd 服务）。Web 管理服务也以 root 运行。
# ============================================================
set -euo pipefail

# 官方环境变量：生命周期上下文始终注入；保留兜底避免手动调用时为空
readonly APP_NAME="${TRIM_APPNAME:-fn-docker-desk}"
readonly APP_DIR="/var/apps/${APP_NAME}"
readonly PKG_APP="${TRIM_APPDEST:-${APP_DIR}/target}"
readonly PKG_VAR="${TRIM_PKGVAR:-${APP_DIR}/var}"
readonly SVC_PORT="${TRIM_SERVICE_PORT:-5558}"
readonly WEB_LOG="/var/log/fn-docker-desk-web.log"
readonly CLI_ENTRY="${PKG_APP}/bin/fn-docker-desk"

# ---------------- 公共函数 ----------------

# 启动 Web 管理服务（以 root 运行）
start_web_service() {
    # 已运行则跳过（精确匹配 Python 进程，避免匹配到 pgrep 自身/bash 包装）
    if ps -eo pid,args | awk '/python.*fn-docker-desk.*web\.py/ && $2 ~ /^python/' | grep -q " --port ${SVC_PORT} " 2>/dev/null || \
       pgrep -f "web.py --port ${SVC_PORT}" >/dev/null 2>&1; then
        return 0
    fi
    [ -f "${PKG_APP}/web.py" ] || return 0

    touch "${WEB_LOG}" 2>/dev/null || true
    chmod 644 "${WEB_LOG}" 2>/dev/null || true

    nohup python3 -u "${PKG_APP}/web.py" --port "${SVC_PORT}" \
        >>"${WEB_LOG}" 2>&1 &
    sleep 1
}

# ---------------- 生命周期入口 ----------------

case $1 in
start)
    # 1. 应用桌面注入（幂等：首次注入 / 升级后恢复配置）
    if [ -x "${CLI_ENTRY}" ]; then
        bash "${CLI_ENTRY}" apply --quiet 2>/dev/null || true
    fi
    # 2. 启动 Web 管理服务
    start_web_service
    exit 0
    ;;
stop)
    # 停止：优先精确匹配，再兜底 pkill
    ps -eo pid,args | awk '/python.*fn-docker-desk.*web\.py/ && $2 ~ /^python/ && $0 ~ / --port '"${SVC_PORT}"' / {print $1}' | xargs -r kill 2>/dev/null || true
    pkill -f "web.py --port ${SVC_PORT}" 2>/dev/null || true
    exit 0
    ;;
status)
    if pgrep -f "web.py --port ${SVC_PORT}" >/dev/null 2>&1; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
