#!/bin/bash
# ============================================================
# fn-docker-desk - 安装后处理（官方规范：运行文件从 TRIM_APPDEST 直接使用）
# ------------------------------------------------------------
# 注入桌面并启动 Web 管理服务，确保应用中心打开时端口已就绪。
# ============================================================
set -euo pipefail

readonly APP_NAME="${TRIM_APPNAME:-fn-docker-desk}"
readonly APP_DIR="/var/apps/${APP_NAME}"
readonly PKG_APP="${TRIM_APPDEST:-${APP_DIR}/target}"
readonly SVC_PORT="${TRIM_SERVICE_PORT:-5558}"
readonly WEB_LOG="/var/log/fn-docker-desk-web.log"
readonly CLI_ENTRY="${PKG_APP}/bin/fn-docker-desk"

# 注入桌面（幂等，迁移旧数据到官方路径会在内部自动完成）
if [ -x "${CLI_ENTRY}" ]; then
    bash "${CLI_ENTRY}" apply --quiet 2>/dev/null || true
fi

# 启动 Web 管理服务（以 root 运行）
if [ -f "${PKG_APP}/web.py" ] && ! pgrep -f "web.py --port ${SVC_PORT}" >/dev/null 2>&1; then
    touch "${WEB_LOG}" 2>/dev/null || true
    chmod 644 "${WEB_LOG}" 2>/dev/null || true
    nohup python3 -u "${PKG_APP}/web.py" --port "${SVC_PORT}" \
        >>"${WEB_LOG}" 2>&1 &
fi

exit 0
