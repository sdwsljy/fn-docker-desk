#!/bin/bash
# ============================================================
# fn-docker-desk - 安装后处理
# ------------------------------------------------------------
# 复制工具文件、注入桌面并启动 Web 管理服务，确保应用中心打开时
# 端口已就绪。与 main start 保持一致的降权策略。
# ============================================================
set -euo pipefail

DEST_DIR="/usr/fn-docker-desk"
SVC_PORT="${TRIM_SERVICE_PORT:-5558}"
WEB_LOG="/var/log/fn-docker-desk-web.log"
APP_USER="${TRIM_USERNAME:-fn-docker-desk}"

# 同步工具文件
mkdir -p "$DEST_DIR"
if [ -d "${TRIM_APPDEST:-}" ]; then
    cp -f "$TRIM_APPDEST"/fn-docker-desk.sh "$DEST_DIR/" 2>/dev/null || true
    cp -f "$TRIM_APPDEST"/web.py "$DEST_DIR/" 2>/dev/null || true
    cp -f "$TRIM_APPDEST"/desktop-inject.js "$DEST_DIR/" 2>/dev/null || true
    chmod +x "$DEST_DIR/fn-docker-desk.sh" 2>/dev/null || true
fi

# 注入桌面（幂等）
if [ -f "$DEST_DIR/fn-docker-desk.sh" ]; then
    bash "$DEST_DIR/fn-docker-desk.sh" apply --quiet 2>/dev/null || true
fi

# 启动 Web 管理服务（降权运行，回退 root）
if [ -f "$DEST_DIR/web.py" ] && ! pgrep -f "web.py --port ${SVC_PORT}" >/dev/null 2>&1; then
    touch "$WEB_LOG" 2>/dev/null || true
    chmod 644 "$WEB_LOG" 2>/dev/null || true
    if id "$APP_USER" >/dev/null 2>&1; then
        chown -R "$APP_USER:$APP_USER" "$DEST_DIR" 2>/dev/null || true
        runuser -u "$APP_USER" -- python3 -u "$DEST_DIR/web.py" --port "$SVC_PORT" \
            >>"$WEB_LOG" 2>&1 &
    else
        nohup python3 -u "$DEST_DIR/web.py" --port "$SVC_PORT" \
            >>"$WEB_LOG" 2>&1 &
    fi
fi

exit 0
